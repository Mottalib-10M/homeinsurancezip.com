---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/zip-lookup/" title="Homeowners insurance premium by ZIP code" width="100%" height="760" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the homeowners insurance lookup by ZIP code, free" description="Local newsrooms and community sites can embed the homeowners insurance lookup by ZIP code and county with one iframe line. No cookie, no tracking, no lead form attached." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the lookup', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the lookup' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the ZIP code lookup</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When new federal data are loaded, the embedded lookup follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the lookup visible, do not alter the frame, and do not place it next to a quote form or an offer to sell insurance. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Homeowners insurance premium by ZIP code and county</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/zip-lookup/" title="Homeowners insurance premium by ZIP code" width="100%" height="760" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
