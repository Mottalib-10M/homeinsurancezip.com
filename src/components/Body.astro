---
/**
 * The HTML body of a content file, with its mini-simulators rendered as islands.
 * `plier` (testeurs naïfs et brief du 2026-11-09 : pages de 15 à 39 écrans sur téléphone) : chaque section <h2> est
 * repliée sous son titre (<details>, contenu entier dans le HTML) ; une section qui porte un mini-calculateur reste
 * ouverte, pour que l'outil se voie et se teste.
 */
import MiniSim from './calc/MiniSim';
import { miniHref } from '../lib/mini-targets';
import { plierSections } from '../lib/plier';
interface Props { html: string; path: string; plier?: boolean }
const { html, path, plier = false } = Astro.props;
const parts = (plier ? plierSections(html) : html).split(/<!--mini:([A-Za-z0-9_]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
---
<div class="prose prose-slate max-w-none prose-headings:font-serif">
  {plier && <p data-chrome class="not-prose mb-2 text-sm text-navy-600">Tap a heading to open it.</p>}
  {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <div data-chrome class="not-prose"><MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={miniHref(p, path)} /></div> : null)}
</div>
