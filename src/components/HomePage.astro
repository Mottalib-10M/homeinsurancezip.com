---
/**
 * Home (the pillar): the ZIP lookup first, the folded answer, the national path 2018-2022 next to the
 * price index, the pillar text, then the 51 states in one sortable-by-eye table and the guides as cards.
 * Text: src/content/home.ts. Tables are generated from the data asset, so they carry data-chrome.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { route, ROUTES } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, SOURCES, table } from '../lib/helpers';
import { GUIDES, STATE_PAGES, stateId } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { gloss } from '../lib/gloss';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const I = K.N.index;
const nat = K.N.years.map((y, i) => [String(y), K.usd(K.N.prem[i]), K.rate(K.N.nonren[i]), K.dec(K.N.freqY[i] * 100, 1), K.pct(K.N.lrY[i], 0), K.dec(I.ppi.annual[String(y)], 1)]);
const hasPage = (slug: string) => STATE_PAGES.some((p) => p.slug === slug);
// Testeurs naïfs du 2026-11-10 : une ligne par État (aujourd'hui, puis 2022), deux groupes titrés ; l'évolution et la
// Floride « -16.5%* » sont sur les pages d'État, avec leur explication en clair.
const rows = [...K.STATES].sort((a, b) => b.prem[4] - a.prem[4]).map((s) => [
  hasPage(s.slug) ? `<a href="${route(stateId(s.slug), lang)}">${s.name}</a>` : s.name,
  K.usd(K.today(s.prem[4])), K.usd(s.prem[4]),
]);
const stHead = ['State', `Today (estimate)`, `Paid in ${K.N.years[4]}`];
const stCap = (what: string) => `${what} Typical (middle) ZIP code of each state, U.S. Treasury file; today's figure is the ${K.N.years[4]} one raised by the national price index of home insurance, not a quote.`;
// Portes d'entrée par profil (brief des cinq règles, 2026-11-10) : boutons au-dessus du calculateur, la question n° 1 d'abord.
const doors = [
  { t: 'How do I pay less?', href: `${route('why-is-home-insurance-going-up', lang)}#act` },
  { t: 'Why did my premium go up?', href: route('why-is-home-insurance-going-up', lang) },
  { t: 'My insurer will not renew', href: route('home-insurance-non-renewal', lang) },
];
const gl = gloss();
const intro = gl(x.intro), resume = gl(x.resume), body = gl(x.why(h));
const faqs = x.faqs.map((f) => ({ ...f, a: gl(f.a) }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{intro}</p>
    <p data-chrome class="mt-2 text-sm text-navy-600">Independent site, not an insurer or a broker. Nothing you type leaves your device.</p>
  </header>
  <nav data-chrome id="start" aria-label="Your question" class="mb-3 scroll-mt-20">
    <ul class="flex flex-wrap gap-2">
      {doors.map((d) => <li><a href={d.href} class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-accent-500 bg-white px-3.5 py-1.5 text-sm font-semibold text-accent-700 hover:bg-accent-50">{d.t} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  </nav>
  <div data-outil data-chrome id="home-zip" class="scroll-mt-20"><Tool kind="lookup" idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600">Built on the U.S. Treasury's January 2025 ZIP code release · <a href={route('method', lang)} class="underline">How the figures are made</a> · <a href={route('about', lang)} class="underline">Who publishes this</a></p>
  <Clamp text={resume} lang={lang} id="clamp-home" class="my-8" />
  <section data-chrome class="mt-8">
    <h2 class="font-serif text-2xl font-bold text-navy-900">The 5 most expensive and the 5 cheapest states</h2>
    <h3 class="mt-4 font-serif text-lg font-bold text-navy-900">Most expensive</h3>
    <Fragment set:html={table(stHead, rows.slice(0, 5), stCap('The five most expensive states.'), ['l', 'r', 'r'])} />
    <h3 class="mt-4 font-serif text-lg font-bold text-navy-900">Cheapest</h3>
    <Fragment set:html={table(stHead, rows.slice(-5).reverse(), stCap('The five cheapest states, cheapest first.'), ['l', 'r', 'r'])} />
    <details class="pli mt-2 rounded-lg border border-navy-200 px-3 py-2">
      <summary class="cursor-pointer font-medium text-navy-900">Show all 50 states and Washington, DC</summary>
      <Fragment set:html={table(stHead, rows, stCap('All 50 states and the District of Columbia, most expensive first.'), ['l', 'r', 'r'])} />
    </details>
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="font-serif text-2xl font-bold text-navy-900">Guides and calculators</h2>
    {GROUPS.map((g) => (
      <div class="mt-4">
        <h3 class="font-serif text-lg font-bold text-navy-900">{g.label}</h3>
        <ul class="mt-2 grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
          {GUIDES.filter((p) => p.group === g.id && ROUTES.some((r) => r.id === p.id)).map((p) => <li><a href={route(p.id, lang)} class="block py-1.5 font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav} →</a></li>)}
        </ul>
      </div>
    ))}
  </section>
  <section class="mt-10"><Body html={body} path={path} plier /></section>
  <section data-chrome class="mt-8">
    <details class="pli rounded-lg border border-navy-200 px-3 py-2">
      <summary class="cursor-pointer font-medium text-navy-900">Year by year, 2018 to 2022: premium, nonrenewals, claims</summary>
      <Fragment set:html={table(['Year', 'Premium per policy', 'Not renewed by the insurer', 'Claims per 100 policies', 'Share of premiums paid back as claims', 'Home insurance price index'], nat, `Middle ZIP code of each year, ${K.num(K.N.zips)} ZIP codes of the Treasury file (nonrenewals without Texas, which did not report them). Price index: home insurance prices charged by insurers, Bureau of Labor Statistics, yearly average.`, ['l', 'r', 'r', 'r', 'r', 'r'])} />
    </details>
  </section>
</PageLayout>
